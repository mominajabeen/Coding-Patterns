#include <iostream>
#include <vector>
#include <unordered_map>
#include <unordered_set>
#include <stack>
using namespace std;

class Solution {
public:
    string removeDuplicateLetters(string s) {
        unordered_map<char, int> count;
        unordered_set<char> present;
        stack<char> result;

        for(char c : s){
            count[c]++;
        }
        for(char c : s){
            if(present.find(c) == present.end()){
                while(!result.empty() && c < result.top() && count[result.top()] > 0){
                    present.erase(result.top());
                    result.pop();
                }
                result.push(c);
                present.insert(c);
            }
            count[c]--;
        }
        // Building the result string from the stack
        string res = "";
        while(!result.empty()){
            res = result.top() + res;
            result.pop();
        }
        return res;
    }
};

